# Output locations
ANALYSIS_PROGRESS_LOG_PATH=./logs/analysis_progress.jsonl
ANALYSIS_RUN_OUTPUT_DIR=./data/evaluation/runs

# PostgreSQL container (Docker Compose)
DATABASE_PORT=5432
DATABASE_NAME=rfp_agent
DATABASE_USER=rfp_agent
DATABASE_PASSWORD=change-me-locally
# Python connection URL: keep credentials and port consistent with the values above.
DATABASE_URL=postgresql+psycopg://rfp_agent:change-me-locally@localhost:5432/rfp_agent?connect_timeout=5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_MAX_RETRIES=2
OPENAI_TIMEOUT_SECONDS=60

# Optional USD prices per million tokens for OPENAI_MODEL. Update when changing models.
# Estimate covers extraction and assessment only; embeddings are excluded.
# Both prices are required for an estimate. Blank means unknown.
OPENAI_INPUT_COST_PER_MIL_TOKENS=
OPENAI_OUTPUT_COST_PER_MIL_TOKENS=

# Project data
TENDER_MANIFEST_PATH=./data/tenders/manifest.csv
TENDER_RAW_DIR=./data/tenders/raw

# Document processing limits
MAX_PDF_MB=25
MAX_PDF_PAGES=250
MAX_REQUIREMENT_CHUNK_CHARACTERS=12000
ANALYSIS_PAGE_THRESHOLD=50

# Retrieval defaults
RETRIEVAL_TOP_K=5
MIN_RETRIEVAL_SCORE=0.0
EVIDENCE_EMBEDDING_BATCH_SIZE=100

# External API opt-in (there is no spending cap)
ENABLE_EXTERNAL_API_CALLS=false
