# Application
APP_NAME=Evidence-First RFP Qualification Agent
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=rfp_agent
DATABASE_USER=rfp_agent
DATABASE_PASSWORD=change-me-locally
DATABASE_URL=postgresql+psycopg://rfp_agent:change-me-locally@localhost:5432/rfp_agent

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_MAX_RETRIES=2
OPENAI_TIMEOUT_SECONDS=60

# Project data
DATA_ROOT=./data
TENDER_MANIFEST_PATH=./data/tenders/manifest.csv
TENDER_RAW_DIR=./data/tenders/raw
TENDER_DERIVED_DIR=./data/tenders/derived

# Document processing limits
MAX_PDF_MB=25
MAX_PDF_PAGES=250
MAX_REQUIREMENT_CHUNK_CHARACTERS=12000

# Retrieval defaults
RETRIEVAL_TOP_K=5
MIN_RETRIEVAL_SCORE=0.0
EVIDENCE_EMBEDDING_BATCH_SIZE=100

# Cost controls
ENABLE_EXTERNAL_API_CALLS=false
MAX_ANALYSIS_COST_USD=1.00
